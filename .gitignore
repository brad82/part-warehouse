# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
.vite/

# Tests and lint caches
coverage/
.eslintcache

# Local data (DATA_DIR): app.json, one folder per project (db, part images,
# model files) and the supplier-page browser's cookies (BROWSER_PROFILE_DIR)
data/

# Local HTTPS certs for the Vite dev server
certs/

# Environment overrides (PORT, HOST, DATA_DIR, PARTS_INDEX_CSV)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Per-installation compose overrides (host paths)
docker-compose.override.yml
# Label PDFs written by the CLI
data/labels/
