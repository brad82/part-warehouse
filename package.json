{
  "name": "parts-warehouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,scraper,terminal \"IMAGE_SCRAPER_URL=127.0.0.1:50051 npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/image-scraper\" \"npm run dev:terminal\"",
    "dev:core": "concurrently -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:terminal": "cargo run --manifest-path apps/terminal/Cargo.toml",
    "import": "npm run import -w apps/cli",
    "cli": "npm run start -w apps/cli --",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:terminal": "cargo test --manifest-path apps/terminal/Cargo.toml"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.26.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
