{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@parts-warehouse/shared": ["packages/shared/src/index.ts"],
      "@parts-warehouse/db": ["packages/db/src/index.ts"],
      "@parts-warehouse/label-pdf": ["packages/label-pdf/src/index.ts"],
      "@parts-warehouse/image-scraper-proto": ["packages/image-scraper-proto/src/index.ts"]
    }
  }
}
